PORT=3000
JWT_SECRET=use-a-long-random-string-in-production
OTP_SECRET=optional-separate-secret-for-otp-hashing

# Forward verified inserts to your existing API (no token; this server strips emailVerificationToken)
UPSTREAM_INSERT_URL=https://backend-1-wsky.onrender.com/insert

# Resend (https://resend.com) — required for real emails; if unset, OTP is logged to server console only
RESEND_API_KEY=
# Must be a verified sender in Resend, e.g. "Tracer Study <onboarding@resend.dev>"
RESEND_FROM=Tracer Study <onboarding@resend.dev>

# CORS: comma-separated origins, or * for any (less secure)
CORS_ORIGIN=*
